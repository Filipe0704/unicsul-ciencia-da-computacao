#include <stdio.h>

int main()
{
    int pm, pt;
    int soma;
    printf("Digite a quantidade recebida pela manhã: ");
    scanf("%d", &pm);
    
    printf("Digite o valor recebido no periodo da tarde: ");
    scanf("%d", &pt);
    soma=pm+pt;
    
    printf("O valor total recebido é: %d\n", soma);

    return 0;
}
